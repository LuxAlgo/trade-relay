{
  "name": "trade-relay",
  "version": "0.1.0",
  "description": "Open-source execution relay for trading alerts. Point TradingView (or anything that can send a webhook, or an AI agent over MCP) at your own deployment and it places the matching order at your broker — safety rails on by default, a full flight recorder, your keys never leave your server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuxAlgo/trade-relay.git"
  },
  "homepage": "https://github.com/LuxAlgo/trade-relay#readme",
  "bugs": "https://github.com/LuxAlgo/trade-relay/issues",
  "keywords": [
    "trading",
    "tradingview",
    "webhook",
    "alerts",
    "broker",
    "alpaca",
    "tradier",
    "automation",
    "trade-execution",
    "mcp",
    "ai-agents",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "sideEffects": false,
  "bin": {
    "trade-relay": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "start": "node dist/cli.js start",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@luxalgo/broker-sdk": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
