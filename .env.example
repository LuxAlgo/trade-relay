# Copy to .env and fill in. Never commit .env.

# The token that protects your webhook URL: POST /webhook/<WEBHOOK_TOKEN>
# Generate one: openssl rand -hex 24
WEBHOOK_TOKEN=

# Protects the dashboard and REST API (sent as Authorization: Bearer <token>).
# Generate one: openssl rand -hex 24
DASHBOARD_TOKEN=

# Alpaca PAPER keys (key id starts with "PK"). Live keys are rejected by design.
ALPACA_KEY=
ALPACA_SECRET=

# Optional: outbound notifications
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
